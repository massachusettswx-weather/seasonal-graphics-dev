# CDS credentials - NEVER COMMIT
.cdsapirc

# the publish watcher's state file - it belongs to the machine, not the repo
data/.publish_fingerprint

# raw / bulky data (re-fetchable with the scripts in this repo)
data/*.grib
data/*.nc
data/arco_chunks/
# the per-year checkpoints of the global ERA5 climatology pull - working
# data, re-fetchable with fetch_era5_snow_arco.py
data/era5_clim_ckpt/
data/seas5_*_snow.npz
*.grib

# python
__pycache__/
*.pyc
.ipynb_checkpoints/

# local preview scratch
site_preview.png

# editors / os
.DS_Store
*.swp

# transient logs and scratch
data/*.log
_*.log
_*.sh
_*.py

# model fetch working dir (large GRIBs, re-fetchable)
data/models/
# local site preview screenshots
preview/

# transient fetch logs / job dumps
data/probe/

# local logs and previews
*.log
preview_*.png

# transient job ids and NFS leftovers
data/*_new.txt
data/jma_snow_job.txt
.nfs*

# the GitHub token: mode 600, never committed
data/.github_token
# the development copy's password: never committed
data/.dev_gate_password

# the daily refresh marker (the machine, not the repo)
data/.daily_fetch_*

# the polar-cap working data: re-fetchable with the scripts in this repo
data/era5_polarcap_profiles.npz
data/polar_cap_recent.npz
data/polar_model_z.json
data/polar_aifs.json
# the GEFSv12's decoded 35-day series IS tracked now: it is the only
# record of a fetch that takes an hour to redo, and a sandbox rebuild
# takes data/ with it.  The file is small (35 leads) and it is what
# lets the fetcher put the series back without downloading it again.
data/polar_ec46_jobs.json
data/polar_ec46_z.json
data/_aifs.lock
data/_aifs_step.grib2

# in-flight downloads (the fetchers write these while the queue runs)
*.part
data/_gefs_*.grib2
# the CORe fetcher's temporary files: they exist only while the fetch
# runs, and a `git add -A` that catches one of them mid-write fails
data/_core_*
data/_polz_*.grib
data/.no_gate
data/.no_publish

# the tests' own backups never belong in the published data directory
docs/data/*.bak

# the queue's live bookkeeping: it changes with every request
data/daily_jobs.json
data/nov_pending.json

# the 3-hourly CORe and the GEFS's own analysis: re-fetchable in seconds
# (no key, no queue), so they are working data, not state
data/polar_core_3hourly.json
data/polar_gefs_f000.json
